{
  // classic — Rosé Pine sectioned layout, true-color. The everyday driver.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "source": "arch",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;5;5", "2": "38;5;2" }
  },

  "display": {
    "brightColor": false,
    "separator": "  ",
    "key": { "type": "icon", "width": 3 },
    "color": { "keys": "38;5;7", "title": "38;5;2", "separator": "38;5;8" },
    "percent": {
      "type": 11, "ndigits": 0,
      "color": { "green": "38;5;2", "yellow": "38;5;3", "red": "38;5;1" }
    },
    "bar": {
      "width": 16,
      "char": { "elapsed": "━", "total": "━" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "38;5;5", "total": "38;5;0" }
    },
    "temp": {
      "color": { "green": "38;5;2", "yellow": "38;5;3", "red": "38;5;1" }
    },
    "size": { "maxPrefix": 8, "ndigits": 1 }
  },

  "modules": [
    { "type": "title", "format": "{#38;5;5}{user-name}{#38;5;8}@{#38;5;2}{host-name}{#}" },
    { "type": "custom", "format": "{#38;5;0}────────────────────────────────────────{#}" },

    { "type": "custom", "format": "{#38;5;1}󰣇  system{#}" },
    { "type": "os",       "key": "os",     "keyColor": "38;5;1", "format": "{pretty-name} {#38;5;8}{arch}{#}" },
    { "type": "kernel",   "key": "kernel", "keyColor": "38;5;1", "format": "{release}" },
    { "type": "packages", "key": "pkgs",   "keyColor": "38;5;1", "format": "{all} {#38;5;8}(pacman){#}" },
    { "type": "shell",    "key": "shell",  "keyColor": "38;5;1", "format": "{pretty-name} {version}" },
    { "type": "uptime",   "key": "uptime", "keyColor": "38;5;1" },
    "break",

    { "type": "custom", "format": "{#38;5;3}󰍹  session{#}" },
    { "type": "wm",           "key": "wm",    "keyColor": "38;5;3", "format": "{pretty-name} {version} {#38;5;8}{protocol-name}{#}" },
    { "type": "display",      "key": "res",   "keyColor": "38;5;3", "compactType": "scaled" },
    { "type": "terminal",     "key": "term",  "keyColor": "38;5;3" },
    { "type": "terminalfont", "key": "font",  "keyColor": "38;5;3" },
    { "type": "wmtheme",      "key": "theme", "keyColor": "38;5;3" },
    "break",

    { "type": "custom", "format": "{#38;5;2}󰘚  hardware{#}" },
    { "type": "cpu",    "key": "cpu",  "keyColor": "38;5;2", "temp": true,
      "format": "{name} {#38;5;8}({cores-logical}){#} {temperature}" },
    { "type": "gpu",    "key": "gpu",  "keyColor": "38;5;2", "format": "{name} {#38;5;8}{type}{#}" },
    { "type": "memory", "key": "mem",  "keyColor": "38;5;2", "format": "{percentage-bar} {used} {#38;5;8}/ {total}{#}" },
    { "type": "swap",   "key": "swap", "keyColor": "38;5;2", "format": "{percentage-bar} {used} {#38;5;8}/ {total}{#}" },
    { "type": "disk",   "key": "disk", "keyColor": "38;5;2", "folders": "/",
      "format": "{size-percentage-bar} {size-used} {#38;5;8}/ {size-total}{#}" },
    { "type": "battery","key": "batt", "keyColor": "38;5;2", "format": "{capacity} {#38;5;8}{status}{#}" },
    "break",

    { "type": "custom", "format": "{#38;5;0}────────────────────────────────────────{#}" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
