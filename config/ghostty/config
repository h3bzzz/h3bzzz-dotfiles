# =============================================================================
#  ghostty  —  terminal for the hyprland rice
#
#  Colours are NOT set here. themes/matugen is regenerated from the wallpaper by
#  ~/.config/hypr/scripts/apply-theme.sh, which then SIGUSR2s every ghostty
#  process to re-read this file. Do not add `background`, `foreground` or
#  `palette` lines below -- they would override the generated theme.
#
#  `palette-generate` is left off. It would NOT fight matugen -- it only derives
#  the extended colours 16-255 from the 16 set in the theme and never overwrites
#  an explicit `palette` line -- so turning it on makes 256-colour programs
#  follow the wallpaper too. It stays off because some older tools hardcode the
#  stock xterm colour cube and look wrong once it moves.
# =============================================================================

# ---- font --------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 12

# JetBrains Mono's programming ligatures (-> => != <= ===) are on by default
# (`calt` and `liga`). Add `font-feature = -calt` and `font-feature = -liga`
# if you would rather see the raw characters.
# `font-thicken` is not set: it only does anything on macOS.

# A little air between lines; easier on long log and nuclei output.
adjust-cell-height = 8%
adjust-cursor-thickness = 2

# ---- theme -------------------------------------------------------------------
theme = matugen

# A wallpaper can hand matugen a low-contrast pair (a washed-out or very light
# image). This forces a minimum perceptual contrast between text and its
# background so a bad wallpaper degrades to "muted" rather than "unreadable".
# 1.0 disables; 3.0 is roughly WCAG AA for large text.
minimum-contrast = 1.4

# Bold text takes the bright half of the palette rather than a synthetic tint.
bold-color = bright

# ---- window ------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-height = 30
window-width = 120
window-decoration = none

background-opacity = 0.90
# Asks the compositor to blur what is behind the window (and behind the quick
# terminal, which is a layer surface Hyprland would not blur on its own). On
# Linux this is on/off only; a blur intensity number is ignored.
background-blur = true

# Dim the split that does not have focus so the active one reads at a glance.
unfocused-split-opacity = 0.80
# A zoomed split stays zoomed while moving between panes with ctrl+shift+hjkl;
# the zoom follows focus instead of dropping back to the full layout.
split-preserve-zoom = navigation

# ---- cursor ------------------------------------------------------------------
cursor-style = bar
cursor-style-blink = true

# ---- scrollback --------------------------------------------------------------
# Default is 50MB per surface. Recon output (subfinder, httpx, nuclei) can blow
# through that, and the whole point of scrollback search below is being able to
# go find it. Memory is allocated lazily and idle history is compressed
# (`scrollback-compression`, on by default), so the ceiling is cheap.
scrollback-limit-bytes = 104857600

# ---- shell integration -------------------------------------------------------
# `title` keeps the tab label following the running command, and marking
# prompts is what makes jump_to_prompt work.
#
# `ssh-env` wraps `ssh` so remote hosts get TERM=xterm-256color instead of
# xterm-ghostty, which they do not know ("unknown terminal type"). Nothing is
# written to the remote side. `ssh-terminfo` is deliberately NOT enabled: it
# installs a terminfo entry into the remote home directory on first connect,
# which is not something to leave behind on a box under test. For your own
# hosts, run `ghostty +ssh --terminfo user@host` once to get full features.
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env
# The login shell is /bin/bash, but this rice lives entirely in ~/.zshrc
# (oh-my-posh prompt, aliases, plugins). Always spawn zsh instead of whatever
# /etc/passwd says, so every ghostty tab/split gets the configured prompt.
# Drop this line if you later run `chsh -s /usr/bin/zsh` and prefer to rely on
# the login shell.
command = /usr/bin/zsh

# Desktop notification when a foreground command that ran longer than the
# threshold finishes in an unfocused surface. swaync renders it. Built for
# `nuclei`, `subfinder` and `zig build` runs you walk away from.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
# The action defaults to bell only; `notify` is what actually sends the
# desktop notification.
notify-on-command-finish-action = bell,notify
desktop-notifications = true

# On a bell, outline the split that rang (on top of the default attention
# request and bell mark in the title) so it is obvious which pane finished.
bell-features = border

# ---- mouse / clipboard -------------------------------------------------------
# Selecting text fills both the primary selection (middle-click paste) and the
# system clipboard.
copy-on-select = both
# Right-click copies when there is a selection, pastes when there is not.
right-click-action = copy-or-paste
# No toast on every copy; the config-reload toast stays.
app-notifications = no-clipboard-copy
mouse-hide-while-typing = true
link-previews = true
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# =============================================================================
#  KEYBINDS
# =============================================================================

# ---- clipboard ----
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+u=copy_url_to_clipboard

# ---- font size ----
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ---- splits ----
# Mirrors the hyprland split feel: same modifier, hjkl to move between panes.
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+e=equalize_splits
keybind = ctrl+alt+left=resize_split:left,40
keybind = ctrl+alt+right=resize_split:right,40
keybind = ctrl+alt+up=resize_split:up,40
keybind = ctrl+alt+down=resize_split:down,40

# ---- tabs ----
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5

# ---- scrollback search (ghostty 1.3+) ----
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+g=search_selection
# Next / previous match. `performable:` hands F3 back to the running program
# whenever no search is active.
keybind = performable:f3=navigate_search:next
keybind = performable:shift+f3=navigate_search:previous

# ---- prompt jumping ----
# Only works because shell-integration marks each prompt. Walks backwards and
# forwards through the commands you ran, which beats scrolling by hand when a
# build dumped 4000 lines.
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1

# ---- scrollback to a file ----
# Writes the whole buffer to a temp file and opens it with xdg-open, i.e. in
# whatever handles text/plain (not $EDITOR). Handy for keeping a scan's output.
# Use `write_scrollback_file:paste` instead to get the path typed at the prompt.
keybind = ctrl+shift+o=write_scrollback_file:open
keybind = ctrl+alt+shift+o=write_scrollback_file:paste

# ---- misc ----
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+i=inspector:toggle
keybind = f11=toggle_fullscreen

# =============================================================================
#  KEY TABLES  (modal keys, ghostty 1.3+)
# =============================================================================
# A key table is a named set of binds that only exists while it is active.
# Inside one, plain keys act on the terminal instead of being typed, so each
# table ends in `catch_all=ignore`: a stray keypress does nothing rather than
# landing in the shell. Escape (or q) always leaves.

# ---- resize mode: ctrl+shift+r ----
# hjkl / arrows resize the focused split in small steps, shift+hjkl in big
# ones, e equalizes, z zooms.
keybind = ctrl+shift+r=activate_key_table:resize
keybind = resize/h=resize_split:left,40
keybind = resize/j=resize_split:down,40
keybind = resize/k=resize_split:up,40
keybind = resize/l=resize_split:right,40
keybind = resize/arrow_left=resize_split:left,40
keybind = resize/arrow_down=resize_split:down,40
keybind = resize/arrow_up=resize_split:up,40
keybind = resize/arrow_right=resize_split:right,40
keybind = resize/shift+h=resize_split:left,160
keybind = resize/shift+j=resize_split:down,160
keybind = resize/shift+k=resize_split:up,160
keybind = resize/shift+l=resize_split:right,160
keybind = resize/e=equalize_splits
keybind = resize/z=toggle_split_zoom
keybind = resize/escape=deactivate_key_table
keybind = resize/enter=deactivate_key_table
keybind = resize/q=deactivate_key_table
keybind = resize/catch_all=ignore

# ---- scroll mode: ctrl+shift+s ----
# Vim-style scrollback reading without touching the mouse.
#   j / k        one line            d / u        half a page
#   f / b        full page           g / shift+g  top / bottom
#   [ / ]        previous / next prompt
#   /            search (leaves scroll mode so the query can be typed)
#   n / shift+n  next / previous match
# Leaving with escape or q also jumps back to the bottom.
keybind = ctrl+shift+s=activate_key_table:scroll
keybind = scroll/j=scroll_page_lines:1
keybind = scroll/k=scroll_page_lines:-1
keybind = scroll/d=scroll_page_fractional:0.5
keybind = scroll/u=scroll_page_fractional:-0.5
keybind = scroll/f=scroll_page_down
keybind = scroll/b=scroll_page_up
keybind = scroll/g=scroll_to_top
keybind = scroll/shift+g=scroll_to_bottom
keybind = scroll/bracket_left=jump_to_prompt:-1
keybind = scroll/bracket_right=jump_to_prompt:1
keybind = scroll/slash=deactivate_key_table
keybind = chain=start_search
keybind = scroll/n=navigate_search:next
keybind = scroll/shift+n=navigate_search:previous
keybind = scroll/escape=deactivate_key_table
keybind = chain=scroll_to_bottom
keybind = scroll/q=deactivate_key_table
keybind = chain=scroll_to_bottom
keybind = scroll/catch_all=ignore

# =============================================================================
#  COMMAND PALETTE  (ctrl+shift+p)
# =============================================================================
# These are added to ghostty's built-in entries, which already cover read-only
# mode, tab titles, tab overview, mouse reporting and copying the *screen* or
# *selection* to a file. What the built-ins lack is prompt jumping and the modes
# above.
#
# Saving the whole *scrollback* is not here: this build (1.4.0 tip) rejects
# write_*_file and resize_split actions inside command-palette-entry -- even
# its own default lines pasted back -- so those stay as keybinds
# (ctrl+shift+o and ctrl+alt+shift+o above).
command-palette-entry = title:"Jump to Previous Prompt",description:"Scroll back to the previous command.",action:"jump_to_prompt:-1"
command-palette-entry = title:"Jump to Next Prompt",description:"Scroll forward to the next command.",action:"jump_to_prompt:1"
command-palette-entry = title:"Mode: Resize Splits",description:"hjkl resize, shift for big steps, e equalize, escape to leave.",action:"activate_key_table:resize"
command-palette-entry = title:"Mode: Scroll",description:"Vim-style scrollback keys. Escape to leave.",action:"activate_key_table:scroll"
command-palette-entry = title:"Split Automatically",description:"Split along the longer side of the current pane.",action:"new_split:auto"
command-palette-entry = title:"Toggle Quick Terminal",description:"Show or hide the drop-down terminal.",action:"toggle_quick_terminal"

# =============================================================================
#  QUICK TERMINAL (drop-down)
# =============================================================================
# Ghostty's own quick terminal: a layer-shell surface that drops from the top
# of whichever monitor the pointer is on. It lives in the main ghostty process,
# so there is no second instance to autostart.
#
# The toggle is SUPER+grave, bound in config/hypr/lua/binds.lua to
# `ghostty +toggle-quick-terminal`. That goes over D-Bus, so it also starts
# ghostty when nothing is running. (A `keybind = global:...` line here would
# work too on Hyprland >= 0.56, but only while a ghostty process is alive.)
quick-terminal-position = top
quick-terminal-screen = mouse
# height,width
quick-terminal-size = 40%,92%
# Stay open when focus moves away; SUPER+grave is the only thing that hides it.
quick-terminal-autohide = false

# ---- shader ------------------------------------------------------------------
# Subtle bloom + vignette. custom-shader-animation=false means it only redraws
# when the terminal content changes, so an idle window costs no GPU -- with it
# true the shader runs continuously at the display's refresh rate.
# Comment the custom-shader line out to go back to a flat terminal.
custom-shader = shaders/bloom.glsl
custom-shader-animation = false

# ---- gtk ---------------------------------------------------------------------
gtk-titlebar = false
gtk-tabs-location = top
gtk-wide-tabs = false
gtk-single-instance = true
linux-cgroup = single-instance
