# Rose Pine Moon Ghostty Configuration

# FONTS
font-family = JetBrainsMono Nerd Font
font-size = 11

# CURSOR & THEME
cursor-style = bar
cursor-style-blink = false

# ROSE PINE MOON COLOR SCHEME
background = #232136
foreground = #e0def4

# Selection
selection-foreground = #e0def4
selection-background = #44415a

# Cursor colors
cursor-color = #56526e
cursor-text = #e0def4

# TRANSPARENCY & BLUR
background-opacity = 0.88

# WINDOW
padding = 8
window-decoration = false
width = 100
height = 100

# SCROLLBACK
scrollback-limit = 10000

# SHELL
command = /usr/bin/zsh

# PERF
gtk-single-instance = false

# MOUSE
mouse-hide-while-typing = true

# COPY/PASTE
copy-on-select = clipboard
