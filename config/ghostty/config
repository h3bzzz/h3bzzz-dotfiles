font-family = JetBrainsMono Nerd Font
font-size = 12
font-thicken = true

#THEME
# Regenerated from the wallpaper into themes/matugen by
# ~/.config/hypr/scripts/apply-theme.sh, which then SIGUSR2s ghostty.
theme = matugen

window-padding-x = 10
window-padding-y = 10
window-height = 30
window-width = 120

background-opacity = 0.90

cursor-style = bar
cursor-style-blink = true

shell-integration = zsh
shell-integration-features = cursor,sudo

# KEYBINDS
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
