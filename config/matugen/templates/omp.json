{
  "//": "Generated by matugen from the current wallpaper. DO NOT EDIT THIS FILE.",
  "//1": "Source: ~/.config/matugen/templates/omp.json -- edit that, then run",
  "//2": "~/.config/hypr/scripts/apply-theme.sh to regenerate.",
  "//3": "The whole config is generated rather than just the colours because",
  "//4": "oh-my-posh has no working include: `extends` errors with EOF on a",
  "//5": "local path, and a palette only resolves when it sits in the same file",
  "//6": "as the segments that reference it via p:<name>.",
  "//7": "matugen and oh-my-posh use the same delimiter, so oh-my-posh Go",
  "//8": "expressions are backslash-escaped in the template and matugen emits",
  "//9": "them literally. See the escaping on the template lines below.",
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,

  "palette": {
    "base":    "{{colors.surface.default.hex}}",
    "surface": "{{colors.surface_container.default.hex}}",
    "overlay": "{{colors.surface_container_high.default.hex}}",
    "muted":   "{{colors.outline.default.hex}}",
    "subtle":  "{{colors.on_surface_variant.default.hex}}",
    "text":    "{{colors.on_surface.default.hex}}",
    "love":    "{{accent.love.hex}}",
    "gold":    "{{accent.gold.hex}}",
    "rose":    "{{accent.rose.hex}}",
    "pine":    "{{accent.pine.hex}}",
    "foam":    "{{accent.foam.hex}}",
    "iris":    "{{accent.iris.hex}}"
  },

  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:iris",
          "options": { "arch": "" },
          "template": "\{{ .Icon \}} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:foam",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": " / ",
            "home_icon": "~"
          },
          "template": "\{{ .Path \}} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:gold",
          "foreground_templates": [
            "\{{ if or (.Working.Changed) (.Staging.Changed) \}}p:love\{{ end \}}",
            "\{{ if and (gt .Ahead 0) (gt .Behind 0) \}}p:rose\{{ end \}}",
            "\{{ if gt .Behind 0 \}}p:rose\{{ end \}}"
          ],
          "options": {
            "branch_icon": " ",
            "commit_icon": " ",
            "tag_icon": " ",
            "native_status": true,
            "status_formats": {
              "Added": "+%d",
              "Modified": "~%d",
              "Deleted": "-%d",
              "Untracked": "?%d"
            }
          },
          "template": "\{{ .HEAD \}}\{{ if .BranchStatus \}} \{{ .BranchStatus \}}\{{ end \}}\{{ if .Working.Changed \}} \{{ .Working.String \}}\{{ end \}}\{{ if .Staging.Changed \}} \{{ .Staging.String \}}\{{ end \}}\{{ if gt .StashCount 0 \}} \{{ .StashCount \}}\{{ end \}} "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:love",
          "options": { "always_enabled": false },
          "template": " \{{ .Code \}} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:gold",
          "options": { "threshold": 3000, "style": "round" },
          "template": " \{{ .FormattedMs \}} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:foam",
          "template": " \{{ .Full \}} "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:rose",
          "template": " \{{ .Full \}} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:love",
          "template": " \{{ .Full \}} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:gold",
          "template": " \{{ .Full \}} "
        },
        {
          "type": "zig",
          "style": "plain",
          "foreground": "p:gold",
          "template": " \{{ .Full \}} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:muted",
          "template": "\{{ if .SSHSession \}} \{{ .UserName \}}@\{{ .HostName \}}\{{ end \}}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:pine",
          "foreground_templates": [ "\{{ if gt .Code 0 \}}p:love\{{ end \}}" ],
          "options": { "always_enabled": true },
          "template": "❯"
        }
      ]
    }
  ],

  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "❯ "
  },

  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "❯❯ "
  }
}
