/* Generated by matugen from the current wallpaper. Do not edit by hand.
   Regenerate: ~/.config/hypr/scripts/apply-theme.sh */
* {
    base:            {{colors.surface.default.hex}};
    surface:         {{colors.surface_container.default.hex}};
    overlay:         {{colors.surface_container_high.default.hex}};
    muted:           {{colors.outline.default.hex}};
    subtle:          {{colors.on_surface_variant.default.hex}};
    text:            {{colors.on_surface.default.hex}};
    love:            {{accent.love.hex}};
    gold:            {{accent.gold.hex}};
    rose:            {{accent.rose.hex}};
    pine:            {{accent.pine.hex}};
    foam:            {{accent.foam.hex}};
    iris:            {{accent.iris.hex}};
    background:      {{colors.surface.default.hex_alpha | set_alpha: 0.93}};
    background-alt:  {{colors.surface_container.default.hex_alpha | set_alpha: 0.93}};
    selected:        {{accent.pine.hex}};
    active:          {{accent.iris.hex}};
    urgent:          {{accent.love.hex}};
    foreground:      {{colors.on_surface.default.hex}};
}
