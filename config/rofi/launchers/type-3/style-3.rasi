@import "shared/colors.rasi"
@import "shared/fonts.rasi"


* {
	background-color: transparent;
	text-color: @foreground;
}


window {
	transparency: "real";
	fullscreen: true;
	location: center;
	anchor: center;
	background-color: @background;
}


mainbox {
	spacing: 40px;
	padding: 84px 140px 110px;
	background-color: transparent;
	children: [ "inputbar", "listview" ];
}


inputbar {
	margin: 0 25%;
	padding: 14px 18px;
	border: 1px solid;
	border-radius: 16px;
	border-color: rgba(196, 167, 231, 0.35);
	background-color: rgba(38, 35, 58, 0.88);
	children: [ "prompt", "entry" ];
}


prompt {
	font: @prompt-font;
	text-color: @iris;
	margin: 0 12px 0 0;
}


entry {
	font: @entry-font;
	placeholder: "Search apps, commands, windows";
	placeholder-color: @muted;
	expand: true;
}


listview {
	columns: 5;
	lines: 2;
	cycle: true;
	dynamic: true;
	layout: vertical;
	fixed-height: true;
	fixed-columns: true;
	spacing: 16px;
	scrollbar: false;
	background-color: transparent;
}


element {
	orientation: vertical;
	spacing: 12px;
	padding: 22px 14px;
	border-radius: 18px;
	background-color: rgba(31, 29, 46, 0.84);
	border: 1px solid;
	border-color: rgba(110, 106, 134, 0.2);
}


element normal.normal {
	background-color: rgba(49, 116, 143, 0.84);
	text-color: @foreground;
}


element selected.normal {
	background-color: rgba(49, 116, 143, 0.22);
	border-color: rgba(156, 207, 216, 0.35);
	text-color: @foreground;
}


element-icon {
	size: 48px;
	background-color: transparent;
	text-color: inherit;
	horizontal-align: 0.5;
}


element-text {
	font: @element-font;
	background-color: transparent;
	text-color: inherit;
	horizontal-align: 0.5;
	vertical-align: 0.5;
}
