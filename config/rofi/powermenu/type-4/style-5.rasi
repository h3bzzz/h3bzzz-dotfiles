@import "shared/colors.rasi"
@import "shared/fonts.rasi"


* {
	background-color: transparent;
	text-color: @foreground;
}


window {
	transparency: "real";
	fullscreen: true;
	background-color: @background;
}


mainbox {
	spacing: 24px;
	margin: 13% 34%;
	padding: 28px;
	border: 1px;
	border-color: rgba(196, 167, 231, 0.30);
	border-radius: 22px;
	background-color: rgba(31, 29, 46, 0.95);
	children: [ "inputbar", "message", "listview" ];
}


inputbar {
	children: [ "prompt" ];
}


prompt {
	font: @prompt-font;
	text-color: @iris;
	horizontal-align: 0.5;
}


message {
	padding: 12px 14px;
	border-radius: 14px;
	background-color: rgba(38, 35, 58, 0.96);
}


textbox {
	font: @message-font;
	text-color: @subtle;
	horizontal-align: 0.5;
}


listview {
	columns: 5;
	lines: 1;
	spacing: 12px;
	cycle: true;
	dynamic: true;
	scrollbar: false;
}


element {
	padding: 20px 14px;
	border-radius: 18px;
	background-color: rgba(38, 35, 58, 0.94);
	border: 1px;
	border-color: rgba(110, 106, 134, 0.22);
}


element selected.normal {
	background-color: rgba(235, 111, 146, 0.18);
	border-color: rgba(246, 193, 119, 0.34);
}


element-text {
	font: "JetBrainsMono Nerd Font Bold 16";
	horizontal-align: 0.5;
	vertical-align: 0.5;
}
