@import "~/.config/rofi/launchers/type-3/shared/colors.rasi"
@import "~/.config/rofi/launchers/type-3/shared/fonts.rasi"


* {
	background-color: transparent;
	text-color: @foreground;
}


window {
	transparency: "real";
	location: center;
	anchor: center;
	width: 760px;
	border: 1px solid;
	border-color: rgba(196, 167, 231, 0.25);
	border-radius: 20px;
	background-color: rgba(25, 23, 36, 0.94);
}


mainbox {
	spacing: 18px;
	padding: 24px;
	children: [ "inputbar", "message", "listview" ];
}


inputbar {
	padding: 12px 14px;
	border-radius: 14px;
	background-color: rgba(38, 35, 58, 0.92);
	children: [ "prompt", "entry" ];
}


prompt {
	font: @prompt-font;
	text-color: @iris;
	margin: 0 10px 0 0;
}


entry {
	placeholder: "Filter wallpapers";
	placeholder-color: @muted;
}


message {
	padding: 10px 12px;
	border-radius: 12px;
	background-color: rgba(31, 29, 46, 0.88);
}


textbox {
	font: @element-font;
	text-color: @subtle;
}


listview {
	lines: 8;
	columns: 1;
	spacing: 10px;
	scrollbar: true;
}


element {
	children: [ "element-icon", "element-text" ];
	orientation: horizontal;
	spacing: 16px;
	padding: 12px 14px;
	border-radius: 14px;
	background-color: rgba(31, 29, 46, 0.84);
	border: 1px solid;
	border-color: rgba(110, 106, 134, 0.18);
}


element-icon {
	size: 72px;
	border-radius: 10px;
	background-color: transparent;
}


element selected.normal {
	background-color: rgba(49, 116, 143, 0.22);
	border-color: rgba(156, 207, 216, 0.3);
}


element-text {
	font: @element-font;
	vertical-align: 0.5;
}
	
