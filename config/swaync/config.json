{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,

  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 10,
  "control-center-margin-left": 8,

  "control-center-width": 420,
  "control-center-height": 1010,
  "fit-to-screen": false,

  "notification-window-width": 420,
  "notification-icon-size": 44,
  "notification-body-image-height": 140,
  "notification-body-image-width": 260,

  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 220,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "label",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "󰂚   Control Center",
      "clear-all-button": true,
      "button-text": "󰎟  Clear"
    },
    "dnd": {
      "text": "󰂛   Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-per-app": false
    },
    "backlight": {
      "label": "󰃟",
      "subsystem": "backlight"
    },
    "mpris": {
      "show-album-art": "when-available",
      "loop-carousel": true,
      "blur": true
    },
    "label": {
      "text": "󰅒   Recent",
      "max-lines": 1
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        { "label": "󰖩  Wi-Fi",   "command": "nm-connection-editor" },
        { "label": "󰂯  Blue",    "command": "blueman-manager" },
        { "label": "󰕾  Audio",   "command": "pavucontrol" },
        { "label": "󰄀  Shot",    "command": "hyprshot -m region -o $HOME/Pictures/screenshots" },
        { "label": "󰸉  Paper",   "command": "qs ipc call wallpaper toggle" },
        { "label": "󰀻  Apps",    "command": "qs ipc call launcher toggle" },
        { "label": "󰌾  Lock",    "command": "hyprlock" },
        { "label": "󰑓  Bar",     "command": "$HOME/.config/waybar/launch.sh" },
        { "label": "󰐥  Power",   "command": "qs ipc call power toggle" }
      ]
    }
  }
}
